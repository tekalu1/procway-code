{
  "name": "procway-code",
  "version": "0.1.0-alpha.1",
  "description": "Local coding agent — events-first, multi-provider (Anthropic / OpenAI / OpenRouter), TUI-ready, Headless API",
  "type": "module",
  "bin": {
    "procway-code": "src/cli.mjs"
  },
  "main": "src/core/index.mjs",
  "exports": {
    ".": "./src/core/index.mjs",
    "./cli": "./src/cli.mjs",
    "./adapters/*": "./src/adapters/*",
    "./jobs": "./src/jobs/delegated-jobs.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tekalu1/procway-code.git"
  },
  "bugs": {
    "url": "https://github.com/tekalu1/procway-code/issues"
  },
  "homepage": "https://github.com/tekalu1/procway-code#readme",
  "license": "MIT",
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "lint": "eslint src/core",
    "prepublishOnly": "pnpm test && pnpm lint"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^10.3.0"
  },
  "optionalDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "keytar": "^7.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "ssh2",
      "vue-demi",
      "node-pty"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
