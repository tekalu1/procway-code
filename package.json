{
  "name": "procway-code",
  "version": "0.1.0-alpha.2",
  "description": "Local coding agent — events-first, multi-provider (Anthropic / OpenAI / OpenRouter), TUI-ready, Headless API",
  "type": "module",
  "bin": {
    "procway-code": "src/cli.mjs"
  },
  "main": "src/core/index.mjs",
  "exports": {
    ".": "./src/core/index.mjs",
    "./cli": "./src/cli.mjs",
    "./adapters/*": "./src/adapters/*",
    "./jobs": "./src/jobs/delegated-jobs.mjs"
  },
  "files": [
    "src/",
    "web/",
    "docs/host-contract.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekalu1/procway-code.git"
  },
  "bugs": {
    "url": "https://github.com/tekalu1/procway-code/issues"
  },
  "homepage": "https://github.com/tekalu1/procway-code#readme",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "lint": "eslint .",
    "lint:exports": "node scripts/check-test-only-exports.mjs",
    "prepublishOnly": "pnpm test && pnpm lint"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^10.3.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "ssh2",
      "vue-demi",
      "node-pty"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
