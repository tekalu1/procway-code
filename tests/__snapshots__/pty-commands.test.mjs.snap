exports[`pty: slash commands and editing > prints the full command list for /help 1`] = `
"[accent]▌[/color] [accentStrong][bold]Commands[/intensity][/color]
  /branch from <messageId>  Branch the conversation from a message id (/branch
                            from <messageId>)
  /checkout <branchSessionId>
                            Resume a branch session by id
  /clear                    Clear the terminal while keeping the session
  /compact [--strategy <name>] [--keep-last <n>]
                            Compact the conversation history
  /config [setup]           Show settings or configure a provider interactively
                            (/config setup)
  /context                  Show resolved instructions / skills
  /exit                     Leave the REPL
  /help                     List all slash commands with a one-line description
  /history                  Print the recent transcript
  /memory                   List persisted memory entries
  /mcp [add|remove|reconnect]
                            List MCP servers, or add/remove/reconnect one
  /model                    Show the active provider:model
  /plan                     Toggle plan mode (queue write tools for end-of-turn
                            approval)
  /resume                   Pick a session to resume
  /status                   Show workspace, session, model, and mode
  /terminal-setup           Bind Shift+Enter to a newline in this terminal
                            (shows a diff first)
  /thinking [off|fold|full]
                            Control the model's reasoning display: off (hidden),
                            fold (one-line summary), full (stream)
  /todos                    Show the agent's running todo list
  /usage                    Show round-by-round usage / cost
"
`;

exports[`pty: slash commands and editing > prints the session panel for /status 1`] = `
"[accent]▌[/color] [accentStrong][bold]Status[/intensity][/color]
  [muted]Workspace[/color]  <workspace>
  [muted]Session  [/color]  <session-id>
  [muted]Model    [/color]  openai-main:gpt-test
  [muted]Approval [/color]  auto-readonly
  [muted]Plan mode[/color]  off
  [muted]Thinking [/color]  folded
  <tool-off-rows>
"
`;

